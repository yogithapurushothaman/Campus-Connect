{
  "name": "campus-connect-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python run.py",
    "dev:next": "npm run dev --prefix my-app",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix my-app"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
